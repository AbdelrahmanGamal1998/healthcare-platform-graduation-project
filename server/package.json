    "jsonwebtoken": "^8.5.1",
    "mongoose": "^5.13.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-nlp": "^4.22.1",
    "node-xlsx": "^0.17.1",
