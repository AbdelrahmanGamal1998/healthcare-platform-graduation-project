# Copy this file to .env and fill in your own values. Never commit .env.

# MongoDB connection string, for example a free MongoDB Atlas cluster or mongodb://127.0.0.1:27017/healthcare
MONGODB_URI=

# Long random strings. They sign the login tokens and the session cookie.
JWT_SECRET=
SESSION_SECRET=

# Stripe test keys from https://dashboard.stripe.com/test/apikeys (used by the payment server)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# The mailbox that sends the pre-examination form and the generated report.
# For Gmail, use an app password, not your account password.
SMTP_USER=
SMTP_PASS=

# Serial port of the Arduino pulse oximeter (COM3 on Windows, /dev/ttyUSB0 or /dev/ttyACM0 on Linux)
ARDUINO_PORT=COM3